# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 仮想環境 ----
.venv/
venv/
env/
ENV/

# ---- IDE / エディタ ----
.vscode/
.idea/
*.swp

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Node / Next.js (frontend) ----
node_modules/
.next/
out/
.turbo/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- 環境変数 ----
.env
.env*.local

# ---- Terraform ----
# .terraform/ はダウンロードしたプロバイダのバイナリ(AWS は展開後 805MB)。
# .terraform.lock.hcl はプロバイダのバージョンを固定するので「コミットする」。
.terraform/
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
*.tfplan
# plan の出力はバイナリだが中身は平文の state 差分(アカウントID/ARN等)が入る
plan.out
*.plan
# 認証情報や環境固有の値が入りうるため除外する
*.auto.tfvars
terraform.tfvars
tf-debug.log
tf.log
crash.log
crash.*.log
*.tfvars.json
override.tf
*_override.tf


# ---- 生成される観測データ(スクリプト実行で再取得できるためコミットしない) ----
backend/data/observations*.csv
backend/data/.download_parts_v1/
backend/data/runtime/

# ---- 機械学習の一時生成物 ----
# アプリが使う backend/ml/models/*.txt と metrics.json は実行資産としてコミットする。
backend/ml/.cache/
backend/ml/checkpoints/
backend/ml/runs/
backend/ml/models/*.tmp
backend/ml/*.log

# ---- Documentation ----
docs/*
!docs/superpowers/


