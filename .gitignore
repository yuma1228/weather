# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 仮想環境 ----
.venv/
venv/
env/
ENV/

# ---- IDE / エディタ ----
.vscode/
.idea/
*.swp

# ---- OS ----
.DS_Store
Thumbs.db
